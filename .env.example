# Fallback chain, tried left to right. Item = provider or provider:model.
# Providers: openai, gemini, openrouter, groq, ollama, custom
# The inspector needs a model that SEES images and CALLS tools. Run scripts/smoke_llm.py on each one.
LLM_PROVIDERS=gemini

# Fill in the keys for the providers you listed (others are skipped).
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional. Some newer models reject non-default temperatures, so unset by default.
# LLM_TEMPERATURE=0

# For provider "custom":
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=
# LLM_MODEL=
