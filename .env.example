# Copy to .env (never commit .env). Fallback chain, tried left to right. Item = provider or provider:model.
# Providers: openai, gemini, openrouter, groq, ollama, custom
# The inspector needs a model that SEES images and CALLS tools. Run scripts/smoke_llm.py on each one.

# Default: local Ollama vision model. Free, no API key, no rate limits. See README for the install steps.
LLM_PROVIDERS=ollama:qwen3-vl:8b-instruct

# Optional cloud fallback (free tier is small: ~100 images/day, max 3 images per request -> also set INSPECTOR_MAX_IMAGES=3):
# LLM_PROVIDERS=ollama:qwen3-vl:8b-instruct,groq:qwen/qwen3.8-27b

# Keys only for the cloud providers you list above (others are skipped).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional. Some newer models reject non-default temperatures, so unset by default.
# LLM_TEMPERATURE=0

# Optional provider-specific request fields, e.g. for Ollama:
# LLM_EXTRA_BODY_OLLAMA={"think": false}

# For provider "custom":
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=
# LLM_MODEL=
